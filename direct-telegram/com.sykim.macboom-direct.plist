    <key>StandardOutPath</key>
    <string>/Users/sykim/Claude_works/local-llm/direct-telegram/bot.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sykim/Claude_works/local-llm/direct-telegram/bot.err.log</string>
</dict>
</plist>
